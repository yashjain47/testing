	Text Type:   	str
	Numeric Types:	int, float, complex
	Sequence Types: list, tuple, range
	Mapping Type:	dict
	Set Types:	    set, frozenset                         ===> set is mutable but frozenset is immutable
	Boolean Type:	bool
